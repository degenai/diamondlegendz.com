{
  "name": "diamondlegendz",
  "main": "workers/site-gate.mjs",
  "compatibility_date": "2026-08-02",
  "routes": [
    {
      "pattern": "diamondlegendz.com/*",
      "zone_name": "diamondlegendz.com"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "RECIPE_LIBRARY",
      "id": "41a8db1ee1a44dd4b1cda095cbdae6cf"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "20260802129",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
